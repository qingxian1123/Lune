{
  "name": "@lune/server",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:kugou": "tsx test/kugou-provider.test.ts",
    "test:providers": "tsx test/provider-system.test.ts",
    "provider": "tsx src/providers/interfaces/cli/provider-cli.ts",
    "deploy:pack": "tsc -b && node dist/providers/interfaces/cli/deploy-pack.js",
    "deploy:clean": "tsc -b && node dist/providers/interfaces/cli/clean-deploy-pack.js"
  },
  "dependencies": {
    "@lune/shared": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-ws": "^10.4.22",
    "@nestjs/websockets": "^10.4.0",
    "NeteaseCloudMusicApi": "4.32.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kugoumusicapi": "https://github.com/MakcRe/KuGouMusicApi/archive/refs/tags/v1.5.1.tar.gz",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
