# 服务端监听端口
PORT=9527
HOST=0.0.0.0

# Provider 非敏感配置与加密凭据目录
# 相对路径基于服务启动目录；生产环境推荐使用绝对路径
LUNE_CONFIG_FILE=./config/providers.json
LUNE_DATA_DIR=./data

# 32 字节主密钥（Base64 或 64 位 hex），用于 AES-256-GCM 加密 Provider 登录凭据
# 可通过 `pnpm provider init` 生成；不得提交真实值
LUNE_MASTER_KEY=

# Provider 管理 API Bearer Token；未配置时管理 API 自动关闭
LUNE_ADMIN_TOKEN=

# JWT 签名密钥(生产环境务必改为长随机串)
JWT_SECRET=lune-dev-secret-change-me
