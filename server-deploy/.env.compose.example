# Advanced manual setup reference. For normal installation, use sudo ./bin/lune install;
# it creates .env with three random secrets and reads the official image.ref.
# If creating .env manually (for migration), fill every value and keep mode 0600.
LUNE_MODE=public
LUNE_IMAGE=ghcr.io/qingxian1123/lune-server:v2.1.0@sha256:REPLACE_WITH_RELEASE_DIGEST
LUNE_DOMAIN=music.example.com
LUNE_PUBLIC_URL=https://music.example.com
LUNE_MASTER_KEY=
LUNE_ADMIN_TOKEN=
JWT_SECRET=
LUNE_ROOM_RETENTION_MS=86400000
LUNE_ROOM_GRACE_MS=30000
LUNE_ROOM_CHECKPOINT_MS=30000
