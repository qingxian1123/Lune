# 服务端监听端口
PORT=9527
HOST=0.0.0.0

# Provider 非敏感配置与加密凭据目录
LUNE_CONFIG_FILE=./config/providers.json
LUNE_DATA_DIR=./data

# 32 字节主密钥（Base64 或 64 位 hex），用于 AES-256-GCM 加密 Provider 登录凭据
LUNE_MASTER_KEY=

# Provider 管理 API Bearer Token；未配置时管理 API 自动关闭
LUNE_ADMIN_TOKEN=

# 网易云音乐登录 Cookie（从浏览器获取,沿用 v1 约定）
# 兼容迁移项：新部署请使用 Provider CLI 扫码登录
MUSIC_COOKIE=

# 启用的音乐源,逗号分隔；顺序决定默认源
MUSIC_PROVIDERS=netease,kugou

# 酷狗登录态，格式示例：token=...;userid=...;dfid=...
# 兼容迁移项：新部署请使用 Provider CLI 扫码登录
KUGOU_COOKIE=

# JWT 签名密钥(生产环境务必改为长随机串)
JWT_SECRET=lune-dev-secret-change-me
