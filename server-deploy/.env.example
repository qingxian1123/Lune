# 服务端监听
PORT=9527
HOST=127.0.0.1
NODE_OPTIONS=--dns-result-order=ipv4first

# Provider 非敏感配置与加密凭据目录
LUNE_CONFIG_FILE=/etc/lune/providers.json
LUNE_DATA_DIR=/var/lib/lune

# 32 字节主密钥（Base64 或 64 位 hex），用于 AES-256-GCM 加密 Provider 登录凭据
LUNE_MASTER_KEY=

# Provider 管理 API Bearer Token；未配置时管理 API 自动关闭
LUNE_ADMIN_TOKEN=

# JWT 签名密钥
JWT_SECRET=
