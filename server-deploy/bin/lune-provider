#!/usr/bin/env bash
set -euo pipefail

environment_file="${LUNE_ENV_FILE:-/etc/lune/lune.env}"
if [[ ! -r "$environment_file" ]]; then
  echo "Cannot read environment file: $environment_file" >&2
  exit 1
fi

set -a
# shellcheck disable=SC1090
source "$environment_file"
set +a

cd /opt/lune/current
exec /usr/local/bin/node dist/providers/interfaces/cli/provider-cli.js "$@"
